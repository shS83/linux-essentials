#!/usr/bin/env bash
# Sync only paths explicitly listed in ~/.dotfiles-sync to a host-specific bare Git repo.
set -Eeuo pipefail

host=$(uname -n)
host=${host%%.*}
repo=${DOTFILES_SYNC_REPO:-"$HOME/.dotfiles-sync-${host}.git"}
config="$HOME/.dotfiles-sync"

[[ -f $config ]] || { printf 'dotfiles-sync: missing configuration: %s\n' "$config" >&2; exit 1; }
[[ -d $repo ]] || { printf 'dotfiles-sync: missing bare repository: %s\n' "$repo" >&2; exit 1; }
[[ $(git --git-dir="$repo" rev-parse --is-bare-repository 2>/dev/null) == true ]] || {
  printf 'dotfiles-sync: not a bare Git repository: %s\n' "$repo" >&2; exit 1;
}

# -C is essential: --work-tree does not change Git's pathspec base from CWD.
# -f is essential: the installer deliberately ignores all new HOME paths by
# default; the whitelist ~/.dotfiles-sync is our explicit opt-in list.
git_home=(git -C "$HOME" --git-dir="$repo" --work-tree="$HOME")
count=0
while IFS= read -r path || [[ -n $path ]]; do
  path=${path%$'\r'}
  [[ -n $path && $path != \#* ]] || continue
  case $path in
    /*|-*|.|..|../*|*/../*|*/..|./*|*/./*|*/.|*/|*'//'*)
      printf 'dotfiles-sync: skipped unsafe path: %q\n' "$path" >&2
      continue ;;
  esac
  if [[ ! -f $HOME/$path && ! -L $HOME/$path ]]; then
    printf 'dotfiles-sync: missing path, skipped: %q\n' "$path" >&2
    continue
  fi
  "${git_home[@]}" add -f -- "$path"
  ((count+=1))
done < "$config"

if "${git_home[@]}" diff --cached --quiet; then
  printf 'dotfiles-sync: no changes (%d paths checked)\n' "$count"
  exit 0
fi
if ! "${git_home[@]}" commit -m "Auto-sync @ ${host} -- $(date +%Y-%m-%d_%H:%M)"; then
  printf 'dotfiles-sync: commit failed; check Git identity/signing\n' >&2
  exit 1
fi
if "${git_home[@]}" remote get-url origin >/dev/null 2>&1; then
  branch=$("${git_home[@]}" symbolic-ref --quiet --short HEAD) || {
    printf 'dotfiles-sync: cannot push detached HEAD\n' >&2; exit 1;
  }
  "${git_home[@]}" push -u origin "HEAD:$branch"
else
  printf 'dotfiles-sync: committed locally (no origin remote; push skipped)\n'
fi
