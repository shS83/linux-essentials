  fi
}

# Listener key = protocol + bind address + port.
# PID changes alone do not trigger new-port alerts.
keys_of() {
  awk -F '\t' 'NF >= 4 {print $1 "\t" $3 "\t" $4}' "$1" | LC_ALL=C sort -u
}

# Find process names for a new listener in the collected snapshot.
# EXCLUDE_PROCESS_NOTIFY suppresses alerts for the matching owners only;
# list/summary/HTML still receive their rows from collect().
# Status 1 means every known owner is notification-excluded.
# If an owner is allowed or unknown, an alert is still sent.
# Suppressed owner names are not shown even when the shared port
# causes an alert; allowed names appear only once.
listener_notify_processes() {
  local snapshot=$1 wanted_proto=$2 wanted_address=$3 wanted_port=$4
  local proto state address port process pid name result=''
  local known_allowed=0 unknown_owner=0 matching=0
  local -a names=()
  local -A seen=()
  while IFS=$'\t' read -r proto state address port process pid; do
    [[ $proto == "$wanted_proto" && $address == "$wanted_address" && $port == "$wanted_port" ]] || continue
    matching=1
    if [[ -z $process || $process == '—' ]]; then
      unknown_owner=1
      continue
    fi
    IFS=',' read -r -a names <<< "$process"
    for name in "${names[@]}"; do
      trim "$name"; name=$REPLY
      [[ -n $name ]] || continue
      is_notify_excluded_process "$name" && continue
      known_allowed=1
      if [[ ! -v seen["$name"] ]]; then
        seen["$name"]=1
        result+="${result:+, }$name"
      fi
    done
  done < "$snapshot"
  if (( matching && !known_allowed && !unknown_owner )); then
    return 1
  fi
  printf '%s' "$result"
}

notify_new() {
  local proto=$1 address=$2 port=$3 process=${4:-}
  local message="${proto^^} ${address}:${port} — external reachability not checked"
  if [[ -n $process ]]; then
    logger -t nadar -- "NEW LISTENER $proto $address:$port process=$process"
    message="${proto^^} ${address}:${port}"$'\n'"Process: ${process}"$'\n'"External reachability not checked"
  else
    logger -t nadar -- "NEW LISTENER $proto $address:$port"
  fi
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a 'NADAR' -u normal -i network-wired \
      'NADAR: new listening port' "$message" || true
  fi
}

check_once() {
  local newfile oldkeys newkeys proto address port process
  mkdir -p -- "$STATE_DIR"
  newfile=$(mktemp "$STATE_DIR/.listeners.XXXXXX")
  oldkeys=$(mktemp "$STATE_DIR/.oldkeys.XXXXXX")
  newkeys=$(mktemp "$STATE_DIR/.newkeys.XXXXXX")
  # Remove temporary files on normal return or interruption.
  trap 'rm -f -- "$newfile" "$oldkeys" "$newkeys"' RETURN
  collect > "$newfile"
  if [[ -f $STATE_FILE ]]; then
    keys_of "$STATE_FILE" > "$oldkeys"
    keys_of "$newfile" > "$newkeys"
    while IFS=$'\t' read -r proto address port; do
      if [[ -n $proto ]]; then
        if process=$(listener_notify_processes "$newfile" "$proto" "$address" "$port"); then
          notify_new "$proto" "$address" "$port" "$process"
        fi
      fi
    done < <(comm -13 "$oldkeys" "$newkeys")
  else
    logger -t nadar -- 'Baseline initialized; existing listeners are not alerted'
  fi
  mv -f -- "$newfile" "$STATE_FILE"
  rm -f -- "$oldkeys" "$newkeys"
  trap - RETURN
}


# Verify that the notification facility actually works. Never touch the baseline.
test_notify() {
  if ! command -v notify-send >/dev/null 2>&1; then
    echo 'NADAR: notify-send is not installed (install libnotify)' >&2
    return 1
  fi
  if notify-send -a NADAR -u normal -i network-wired \
      'NADAR: test notification' 'Desktop notifications are working.'; then
    echo 'Test notification sent.'
  else
    echo 'NADAR: the notification service did not accept the test alert.' >&2
    return 1
  fi
}

poke_remote() {
  local answer
  if ! command -v timeout >/dev/null 2>&1; then
    echo 'NADAR: timeout (coreutils) is required for --poke-remote.' >&2
    return 1
  fi
  if ! answer=$(timeout 7 bash -c '
      exec 3<>"/dev/tcp/$1/$2" || exit 1
      printf "PING\n" >&3
      IFS= read -r -t 4 reply <&3 || exit 1
      printf "%s" "$reply"
    ' _ "$REMOTE_POKE_HOST" "$REMOTE_POKE_PORT" 2>/dev/null); then
    printf 'Remote health check failed: %s:%s (no valid response).\n' \
      "$REMOTE_POKE_HOST" "$REMOTE_POKE_PORT" >&2
    return 1
  fi
  if [[ $answer == OK ]]; then
    printf 'Remote health: OK (%s:%s)\n' "$REMOTE_POKE_HOST" "$REMOTE_POKE_PORT"
  else
    printf 'Remote health check failed: unexpected response from %s:%s.\n' \
      "$REMOTE_POKE_HOST" "$REMOTE_POKE_PORT" >&2
    return 1
  fi
}

# Produce two sorted CSV port lists. Exclude loopback-only sockets when
# automatically enumerating internet-facing candidates on IPv4.
scan_ports() {
  local raw=${1:-} proto address port state process pid
  local item first last number
  local -A tcp_seen=() udp_seen=()
  local -a items=()
  if [[ -n $raw ]]; then
    IFS=',' read -r -a items <<< "$raw"
    for item in "${items[@]}"; do
      trim "$item"; item=${REPLY^^}
      if [[ ! $item =~ ^(TCP|UDP):([0-9]+)(-([0-9]+))?$ ]]; then
        printf 'NADAR: invalid port specification: %s\n' "$item" >&2; return 2
      fi
      proto=${BASH_REMATCH[1]}
      first=${BASH_REMATCH[2]}
      last=${BASH_REMATCH[4]:-$first}
      if (( 10#$first < 1 || 10#$first > 65535 || 10#$last > 65535 || 10#$first > 10#$last )); then
        printf 'NADAR: invalid port range: %s\n' "$item" >&2; return 2
      fi
      # Bound expanded ranges to keep a mistaken flag from triggering
      # an enormous remote scan. Small explicit ranges are supported.
      if (( 10#$last - 10#$first > 127 )); then
        printf 'NADAR: range exceeds 128 ports: %s\n' "$item" >&2; return 2
      fi
      for ((number=10#$first; number<=10#$last; number++)); do
        if [[ $proto == TCP ]]; then tcp_seen[$number]=1; else udp_seen[$number]=1; fi
      done
    done
  else
    local collected
    if ! collected=$(collect); then
      echo 'NADAR: unable to obtain local listeners using ss.' >&2; return 1
    fi
    while IFS=$'\t' read -r proto state address port process pid; do
      [[ -n $proto ]] || continue
      case $address in
        127.*|\[::1\]|\[::ffff:127.*\]|::1|localhost) continue ;;
      esac
      [[ $port =~ ^[0-9]+$ ]] || continue
      if [[ $proto == tcp ]]; then tcp_seen["$port"]=1; else udp_seen["$port"]=1; fi
    done <<< "$collected"
  fi
  local tcp_csv='' udp_csv=''
  if ((${#tcp_seen[@]})); then tcp_csv=$(printf '%s\n' "${!tcp_seen[@]}" | sort -n | paste -sd, -); fi
  if ((${#udp_seen[@]})); then udp_csv=$(printf '%s\n' "${!udp_seen[@]}" | sort -n | paste -sd, -); fi
  printf '%s\t%s\n' "$tcp_csv" "$udp_csv"
}

# A restricted, root-owned Nmap wrapper on Ouroboros performs both protocols.
# Validate every interpolated value before constructing the SSH command.
# The sudoers entry authorizes ONLY the wrapper, not unrestricted Nmap.
remote_nmap() {
  local proto=$1 ports=$2 target=$3 cmd output result
  [[ $proto == tcp || $proto == udp ]] || {
    echo 'NADAR: invalid scan protocol.' >&2; return 2;
  }
  [[ $ports =~ ^[0-9]+(,[0-9]+)*$ ]] || {
    echo 'NADAR: invalid scan port list.' >&2; return 2;
  }
  valid_ipv4 "$target" || {
    echo 'NADAR: invalid remote scan target.' >&2; return 2;
  }
  cmd="sudo -n /usr/local/libexec/nadar-scan $proto $ports $target"
  if output=$(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ConnectionAttempts=1 \
      "$REMOTE_SSH_HOST" "$cmd" 2>&1); then
    printf '%s' "$output"
  else
    result=$?
    printf '%s\n' "$output" >&2
    return "$result"
  fi
}

show_scan_results() {
  local proto=$1 ports_csv=$2 scan_output=$3 line entries entry port status rest key
  local -A states=()
  local -a requested=() observed=()
  while IFS= read -r line; do
    [[ $line == Host:*'Ports: '* ]] || continue
    entries=${line#*'Ports: '}
    entries=${entries%%$'\t'Ignored*}
    IFS=',' read -r -a observed <<< "$entries"
    for entry in "${observed[@]}"; do
      trim "$entry"; entry=$REPLY
      [[ $entry =~ ^([0-9]+)/([^/]+)/([a-z]+)/ ]] || continue
      [[ ${BASH_REMATCH[3]} == "$proto" ]] || continue
      states["${BASH_REMATCH[1]}"]=${BASH_REMATCH[2]}
    done
  done <<< "$scan_output"
  IFS=',' read -r -a requested <<< "$ports_csv"
  for port in "${requested[@]}"; do
    status=${states["$port"]:-not-reported}
    case $status in
      open) printf '%b%-4s%b %5s  %b%s%b\n' "$VIOLET" "${proto^^}" "$RESET" "$port" "$GREEN" "$status" "$RESET" ;;
      closed) printf '%b%-4s%b %5s  %b%s%b\n' "$VIOLET" "${proto^^}" "$RESET" "$port" "$RED" "$status" "$RESET" ;;
      *) printf '%b%-4s%b %5s  %b%s%b\n' "$VIOLET" "${proto^^}" "$RESET" "$port" "$AMBER" "$status" "$RESET" ;;
    esac
  done
}

remote_verify() {
  local requested=${1:-} target ports tcp_csv udp_csv output retval=0
  local discovered
  if ! discovered=$(scan_ports "$requested"); then return 2; fi
  # Tabs delimit the lists even when one is empty.
  # Bash read with tab IFS collapses empty columns; parse directly instead.
  tcp_csv=${discovered%%$'\t'*}
  udp_csv=${discovered#*$'\t'}
  if [[ -z $tcp_csv && -z $udp_csv ]]; then
    echo 'NADAR: no eligible listening ports to scan.'
    return 0
  fi
  target=$REMOTE_SCAN_TARGET
  if [[ -z $target ]]; then
    if ! target=$(curl -4fsS --connect-timeout 4 --max-time 8 https://ifconfig.co/ip); then
      echo 'NADAR: unable to determine public IPv4; set REMOTE_SCAN_TARGET.' >&2
      return 1
    fi
    target=${target//$'\r'/}
    target=${target//$'\n'/}
    valid_ipv4 "$target" || {
      echo 'NADAR: public-IP endpoint returned an invalid IPv4 address.' >&2; return 1;
    }
  fi
  printf 'NADAR remote verification — target %s, scanner %s\n' "$target" "$REMOTE_SSH_HOST"
  echo 'Results describe reachability from the remote scanner, not the local firewall rules.'
  if [[ -n $tcp_csv ]]; then
    if output=$(remote_nmap tcp "$tcp_csv" "$target"); then
      show_scan_results tcp "$tcp_csv" "$output"
    else
      echo 'NADAR: remote TCP scan failed (check SSH and the remote sudo helper).' >&2; retval=1
    fi
  fi
  if [[ -n $udp_csv ]]; then
    if output=$(remote_nmap udp "$udp_csv" "$target"); then
      show_scan_results udp "$udp_csv" "$output"
      echo 'UDP open|filtered does not confirm an open port.'
    else
      printf 'NADAR: UDP ports not verified (check remote scanner helper and sudoers).\n' >&2
      retval=1
    fi
  fi
  return "$retval"
}


# Parse Nmap grepable output (-oG -), not the human-oriented colored view.
# Every requested port MUST be present; truncated/failed scans cannot update
# monitoring state or accidentally manufacture "newly open" transitions.
scan_state_rows() {
  local proto=$1 ports_csv=$2 scan_output=$3 line entries entry port status observed_proto
  local -A states=()
  local -a entries_array=() requested=()
  while IFS= read -r line; do
    [[ $line == Host:*'Ports: '* ]] || continue
    entries=${line#*'Ports: '}
    entries=${entries%%$'\t'Ignored*}
    IFS=',' read -r -a entries_array <<< "$entries"
    for entry in "${entries_array[@]}"; do
      trim "$entry"; entry=$REPLY
      if [[ $entry =~ ^([0-9]+)/([^/]+)/([a-z]+)/ ]]; then
        port=${BASH_REMATCH[1]}
        status=${BASH_REMATCH[2]}
        observed_proto=${BASH_REMATCH[3]}
        [[ $observed_proto == "$proto" ]] || continue
        case $status in
          open|closed|filtered|unfiltered|open\|filtered|closed\|filtered) states[$port]=$status ;;
          *) printf 'NADAR: unrecognized Nmap state: %s\n' "$status" >&2; return 1 ;;
        esac
      fi
    done
  done <<< "$scan_output"
  IFS=',' read -r -a requested <<< "$ports_csv"
  for port in "${requested[@]}"; do
    [[ -v states[$port] ]] || {
      printf 'NADAR: incomplete %s scan; port %s not reported.\n' "${proto^^}" "$port" >&2
      return 1
    }
    printf '%s\t%s\t%s\n' "${proto^^}" "$port" "${states[$port]}"
  done
}

# Return 1 if all known local owners for this protocol/port were excluded
# by EXCLUDE_PROCESS_NOTIFY. Missing process information never suppresses
# security notifications. Emit the surviving owner names when known.
remote_notify_processes() {
  local snapshot=$1 wanted_proto=$2 wanted_port=$3
  local proto state address port process pid name result=''
  local matched=0 allowed=0 unknown=0
  local -a names=()
  local -A seen=()
  while IFS=$'\t' read -r proto state address port process pid; do
    [[ $proto == "${wanted_proto,,}" && $port == "$wanted_port" ]] || continue
    # The public-IP scan cannot reach a loopback-only listener. Avoid
    # suppressing an alert just because an excluded app uses the same port
    # on localhost as another (possibly forwarded) service.
    case $address in
      127.*|\[::1\]|\[::ffff:127.*\]|::1|localhost) continue ;;
    esac
    matched=1
    if [[ -z $process || $process == '—' ]]; then unknown=1; continue; fi
    IFS=',' read -r -a names <<< "$process"
    for name in "${names[@]}"; do
      trim "$name"; name=$REPLY
      [[ -n $name ]] || continue
      if is_notify_excluded_process "$name"; then continue; fi
      allowed=1
      if [[ ! -v seen[$name] ]]; then
        seen[$name]=1
        result+="${result:+, }$name"
      fi
    done
  done < "$snapshot"
  if ((matched && !allowed && !unknown)); then return 1; fi
  printf '%s' "$result"
}

notify_remote_open() {
  local proto=$1 port=$2 target=$3 process=$4
  local message="${proto} ${target}:${port} — verified OPEN from ${REMOTE_SSH_HOST}"
  if [[ -n $process ]]; then message+=$'\n'"Process: $process"; fi
  printf 'NADAR REMOTE ALERT: newly open %s/%s at %s (scanner: %s)%s\n' \
    "$proto" "$port" "$target" "$REMOTE_SSH_HOST" "${process:+ process=$process}"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a NADAR -u critical -i security-high \
      'NADAR: externally reachable port' "$message" || true
  fi
}

# Run via a systemd --user oneshot timer (no daemon holding an SSH session).
# Do not update the baseline unless ALL requested scans and their parsing
# completed successfully. flock prevents concurrent manual/timer runs.
remote_watch_once() (
  local requested=${1:-$REMOTE_WATCH_PORTS}
  local discovered tcp_csv udp_csv target output currentfile lockfile
  local proto port state key oldstate process new_alerts=0 count=0
  local -A previous=()
  local -a meta=()
  mkdir -p -- "$STATE_DIR"
  lockfile=$STATE_DIR/remote-watch.lock
  exec {watch_lock}> "$lockfile"
  if ! flock -n "$watch_lock"; then
    echo 'NADAR: another remote watch scan is still running; skipping.'
    exit 0
  fi
  if ! discovered=$(scan_ports "$requested"); then exit 2; fi
  tcp_csv=${discovered%%$'\t'*}
  udp_csv=${discovered#*$'\t'}
  if [[ -z $tcp_csv && -z $udp_csv ]]; then
    echo 'NADAR: no eligible ports for remote watch; baseline unchanged.'
    exit 0
  fi
  target=$REMOTE_SCAN_TARGET
  if [[ -z $target ]]; then
    if ! target=$(curl -4fsS --connect-timeout 4 --max-time 8 https://ifconfig.co/ip); then
      echo 'NADAR: could not determine public IPv4; baseline unchanged.' >&2
      exit 1
    fi
    target=${target//$'\r'/}; target=${target//$'\n'/}
    valid_ipv4 "$target" || { echo 'NADAR: invalid public IPv4; baseline unchanged.' >&2; exit 1; }
  fi
  currentfile=$(mktemp "$STATE_DIR/.remote-watch.XXXXXXXX")
  trap 'rm -f -- "$currentfile"' EXIT
  printf '#\t%s\t%s\n' "$target" "$REMOTE_SSH_HOST" > "$currentfile"
  if [[ -n $tcp_csv ]]; then
    if ! output=$(remote_nmap tcp "$tcp_csv" "$target"); then
      echo 'NADAR: remote TCP watch failed; baseline unchanged.' >&2; exit 1
    fi
    if ! scan_state_rows tcp "$tcp_csv" "$output" >> "$currentfile"; then
      echo 'NADAR: incomplete TCP watch scan; baseline unchanged.' >&2; exit 1
    fi
  fi
  if [[ -n $udp_csv ]]; then
    if ! output=$(remote_nmap udp "$udp_csv" "$target"); then
      echo 'NADAR: remote UDP watch failed; baseline unchanged.' >&2; exit 1
    fi
    if ! scan_state_rows udp "$udp_csv" "$output" >> "$currentfile"; then
      echo 'NADAR: incomplete UDP watch scan; baseline unchanged.' >&2; exit 1
    fi
  fi
  local remote_file=$STATE_DIR/remote-watch.tsv
  local old_target='' old_scanner=''
  if [[ -f $remote_file ]]; then
    IFS=$'\t' read -r _ old_target old_scanner < "$remote_file" || true
    if [[ $old_target == "$target" && $old_scanner == "$REMOTE_SSH_HOST" ]]; then
      while IFS=$'\t' read -r proto port state; do
        [[ $proto == '#' || -z $proto ]] && continue
        previous["$proto:$port"]=$state
      done < "$remote_file"
    else
      echo 'NADAR: target/scanner changed; creating a new silent remote baseline.'
      mv -f -- "$currentfile" "$remote_file"
      exit 0
    fi
  else
    echo "NADAR: remote baseline initialized for $target via $REMOTE_SSH_HOST (no alerts)."
    mv -f -- "$currentfile" "$remote_file"
    exit 0
  fi
  local snapshot
  snapshot=$(mktemp "$STATE_DIR/.remote-listeners.XXXXXXXX")
  trap 'rm -f -- "$currentfile" "$snapshot"' EXIT
  if ! collect > "$snapshot"; then
    echo 'NADAR: local listener lookup failed; baseline unchanged.' >&2; exit 1
  fi
  while IFS=$'\t' read -r proto port state; do
    [[ $proto == '#' || -z $proto ]] && continue
    ((count+=1))
    key="$proto:$port"
    oldstate=${previous[$key]:-not-monitored}
    # An OPEN transition means the previous successful scan was not OPEN.
    # Only Nmap's exact "open" status qualifies; "open|filtered" never does.
    if [[ $state == open && $oldstate != open ]]; then
      if process=$(remote_notify_processes "$snapshot" "$proto" "$port"); then
        notify_remote_open "$proto" "$port" "$target" "$process"
        ((new_alerts+=1))
      fi
    fi
  done < "$currentfile"
  mv -f -- "$currentfile" "$remote_file"
  printf 'NADAR remote watch: checked %d port(s), %d new OPEN alert(s), target %s.\n' \
    "$count" "$new_alerts" "$target"
)

case ${1:-} in
  ''|--list) show_list ;;
  --summary) show_summary ;;
  --summary-html) summary_html ;;
  --watch)
    echo "NADAR monitoring local listeners every ${INTERVAL}s" >&2
    while :; do check_once; sleep "$INTERVAL"; done
    ;;
  --once) check_once ;;
  --test-notify) test_notify ;;
  --poke-remote) poke_remote ;;
  --scan|--remote-verify)
    (($# <= 2)) || { echo 'NADAR: --scan accepts one optional port list.' >&2; exit 2; }
    remote_verify "${2:-}" ;;
  --remote-watch-once)
    (($# <= 2)) || { echo 'NADAR: --remote-watch-once accepts one optional port list.' >&2; exit 2; }
    remote_watch_once "${2:-$REMOTE_WATCH_PORTS}" ;;
  --reset-remote) rm -f -- "$STATE_DIR/remote-watch.tsv"; echo 'Remote watch baseline reset.' ;;
  --remote-watch-status) systemctl --user status nadar-remote-watch.timer --no-pager ;;
  --status) systemctl --user status nadar.service --no-pager ;;
  --reset) rm -f -- "$STATE_FILE"; echo 'Listener baseline reset.' ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
