#!/usr/bin/env bash
set -Eeuo pipefail

APP=nadar
# Configuration is parsed as data, not sourced as shell code.
CONFIG_FILE=${NADAR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/nadar/nadar.conf}
LISTENPROTO='TCP,UDP'
EXCLUDEPORTS=''
EXCLUDE_PROCESSES=''
EXCLUDE_PIDS=''
EXCLUDE_PROCESS_NOTIFY=''
declare -a FILTER_PROCESSES=() FILTER_PIDS=() FILTER_NOTIFY_PROCESSES=()
INTERVAL=10
REMOTE_POKE_HOST='prometheus-alexander.fi'
REMOTE_POKE_PORT=42000
REMOTE_SSH_HOST='ouroboros'
REMOTE_SCAN_TARGET=''
REMOTE_WATCH_PORTS=''

trim() {
  local v=$1
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  REPLY=$v
}

valid_ipv4() {
  local ip=$1 part
  local -a octets=()
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS='.' read -r -a octets <<< "$ip"
  ((${#octets[@]} == 4)) || return 1
  for part in "${octets[@]}"; do
    ((${#part} <= 3)) && (( 10#$part <= 255 )) || return 1
  done
}

load_config() {
  local line key value item proto port range_start range_end
  if [[ -f $CONFIG_FILE ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      trim "$line"; line=$REPLY
      [[ -z $line || ${line:0:1} == '#' ]] && continue
      if [[ ! $line =~ ^([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
        printf 'NADAR: invalid config line: %s\n' "$line" >&2; return 2
      fi
      key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
      trim "$value"; value=$REPLY
      if [[ $value == \"*\" || $value == \'*\' ]]; then
        value=${value:1:${#value}-2}
      fi
      case $key in
        LISTENPROTO) LISTENPROTO=$value ;;
        EXCLUDEPORTS) EXCLUDEPORTS=$value ;;
        EXCLUDE_PROCESSES) EXCLUDE_PROCESSES=$value ;;
        EXCLUDE_PIDS) EXCLUDE_PIDS=$value ;;
        EXCLUDE_PROCESS_NOTIFY) EXCLUDE_PROCESS_NOTIFY=$value ;;
        NADAR_INTERVAL) INTERVAL=$value ;;
        REMOTE_POKE_HOST) REMOTE_POKE_HOST=$value ;;
        REMOTE_POKE_PORT) REMOTE_POKE_PORT=$value ;;
        REMOTE_SSH_HOST) REMOTE_SSH_HOST=$value ;;
        REMOTE_SCAN_TARGET) REMOTE_SCAN_TARGET=$value ;;
        REMOTE_WATCH_PORTS) REMOTE_WATCH_PORTS=$value ;;
        *) printf 'NADAR: unknown setting %s\n' "$key" >&2; return 2 ;;
      esac
    done < "$CONFIG_FILE"
  fi
  # Environment variable overrides the config-file polling interval.
  INTERVAL=${NADAR_INTERVAL:-$INTERVAL}
  LISTENPROTO=${LISTENPROTO^^}
  LISTENPROTO=${LISTENPROTO//[[:space:]]/}
  case $LISTENPROTO in
    TCP|UDP|TCP,UDP|UDP,TCP) ;;
    *) printf 'NADAR: LISTENPROTO must be TCP, UDP, or TCP,UDP\n' >&2; return 2 ;;
  esac
  [[ $INTERVAL =~ ^[0-9]+$ ]] && (( 10#$INTERVAL >= 1 )) || {
    echo 'NADAR: NADAR_INTERVAL must be a positive integer' >&2; return 2;
  }
  EXCLUDEPORTS=${EXCLUDEPORTS^^}
  EXCLUDEPORTS=${EXCLUDEPORTS//[[:space:]]/}
  local -a excludes=()
  IFS=',' read -r -a excludes <<< "$EXCLUDEPORTS"
  for item in "${excludes[@]}"; do
    [[ -z $item ]] && continue
    if [[ $item =~ ^((TCP|UDP):)?([0-9]+)(-([0-9]+))?$ ]]; then
      range_start=${BASH_REMATCH[3]}
      range_end=${BASH_REMATCH[5]:-${BASH_REMATCH[3]}}
      (( 10#$range_start <= 65535 && 10#$range_end <= 65535 && 10#$range_start <= 10#$range_end )) || {
        echo "NADAR: invalid port range: $item" >&2; return 2;
      }
    else
      echo "NADAR: invalid EXCLUDEPORTS value: $item" >&2; return 2
    fi
  done
  # Prepare process-name and PID filters. Empty lists are allowed.
  local -a names=() numbers=()
  IFS=',' read -r -a names <<< "$EXCLUDE_PROCESSES"
  for item in "${names[@]}"; do
    trim "$item"; item=$REPLY
    [[ -n $item ]] || { echo 'NADAR: empty entry in EXCLUDE_PROCESSES' >&2; return 2; }
    FILTER_PROCESSES+=("${item,,}")
  done
  # Notification-only exclusions do not remove owners from reports.
  IFS=',' read -r -a names <<< "$EXCLUDE_PROCESS_NOTIFY"
  for item in "${names[@]}"; do
    trim "$item"; item=$REPLY
    [[ -n $item ]] || { echo 'NADAR: empty entry in EXCLUDE_PROCESS_NOTIFY' >&2; return 2; }
    FILTER_NOTIFY_PROCESSES+=("${item,,}")
  done
  IFS=',' read -r -a numbers <<< "$EXCLUDE_PIDS"
  for item in "${numbers[@]}"; do
    trim "$item"; item=$REPLY
    [[ $item =~ ^[0-9]+$ ]] || {
      echo "NADAR: invalid PID in EXCLUDE_PIDS: $item" >&2; return 2;
    }
    # Normalize leading zeroes without integer overflow.
    while [[ ${#item} -gt 1 && $item == 0* ]]; do item=${item#0}; done
    [[ $item != 0 ]] || { echo 'NADAR: PID 0 is not a valid exclusion' >&2; return 2; }
    FILTER_PIDS+=("$item")
  done
  [[ $REMOTE_POKE_HOST =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] || {
    echo 'NADAR: REMOTE_POKE_HOST must be a hostname or IPv4 address' >&2; return 2;
  }
  [[ $REMOTE_SSH_HOST =~ ^([a-zA-Z0-9_.-]+@)?[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || {
    echo 'NADAR: invalid REMOTE_SSH_HOST (use a hostname or SSH alias)' >&2; return 2;
  }
  if [[ ! $REMOTE_POKE_PORT =~ ^[0-9]+$ ]] || (( 10#$REMOTE_POKE_PORT < 1 || 10#$REMOTE_POKE_PORT > 65535 )); then
    echo 'NADAR: REMOTE_POKE_PORT must be in the range 1-65535' >&2; return 2
  fi
  if [[ -n $REMOTE_SCAN_TARGET ]]; then
    valid_ipv4 "$REMOTE_SCAN_TARGET" || {
      echo 'NADAR: REMOTE_SCAN_TARGET must be a valid IPv4 address' >&2; return 2;
    }
  fi
}

is_excluded_owner() {
  local name=${1,,} pid=$2 item
  for item in "${FILTER_PROCESSES[@]}"; do
    [[ $name == "$item" ]] && return 0
  done
  for item in "${FILTER_PIDS[@]}"; do
    [[ $pid == "$item" ]] && return 0
  done
  return 1
}

is_notify_excluded_process() {
  local name=${1,,} item
  for item in "${FILTER_NOTIFY_PROCESSES[@]}"; do
    [[ $name == "$item" ]] && return 0
  done
  return 1
}

allowed_listener() {
  local proto=${1^^} port=$2 item itemproto first last
  [[ ,$LISTENPROTO, == *",$proto,"* ]] || return 1
  local -a excludes=()
  IFS=',' read -r -a excludes <<< "$EXCLUDEPORTS"
  for item in "${excludes[@]}"; do
    [[ -z $item ]] && continue
    itemproto=''
    if [[ $item == *:* ]]; then itemproto=${item%%:*}; item=${item#*:}; fi
    [[ -z $itemproto || $itemproto == "$proto" ]] || continue
    first=${item%%-*}; last=$first
    [[ $item == *-* ]] && last=${item#*-}
    if [[ $port =~ ^[0-9]+$ ]] && (( 10#$port >= 10#$first && 10#$port <= 10#$last )); then
      return 1
    fi
  done
  return 0
}

load_config
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/nadar
STATE_FILE=$STATE_DIR/listeners.tsv

if [[ -t 1 && ${NO_COLOR:-} == '' ]]; then
  RESET=$'\e[0m'; DIM=$'\e[2m'; VIOLET=$'\e[38;2;184;140;255m'; BLUE=$'\e[38;2;91;192;255m'
  AMBER=$'\e[38;2;255;197;109m'; GREEN=$'\e[38;2;110;231;173m'; RED=$'\e[38;2;255;133;149m'
else
  RESET= DIM= VIOLET= BLUE= AMBER= GREEN= RED=
fi

usage() {
  cat <<'HELP'
NADAR - Network Anomaly Detection and Reporting v0.7.0

Usage:
  nadar [--list]                    Show colorized local TCP/UDP sockets
  nadar --summary                   Show aggregated listening endpoints
  nadar --summary-html              Generate summary.html and open the browser
  nadar --watch                     Monitor new listeners; send desktop alerts
  nadar --once                      Run a single detection pass
  nadar --test-notify               Send a test desktop notification
  nadar --poke-remote               Request PING/OK on remote TCP port 42000
  nadar --scan [PORTS]              Remote TCP/UDP Nmap scan via restricted sudo helper
  nadar --remote-verify [PORTS]     Alias of --scan (backward compatible)
  nadar --remote-watch-once [PORTS] Compare remote scan to baseline; alert on newly open ports
  nadar --reset-remote             Remove remote-watch baseline (next scan is silent)
  nadar --remote-watch-status      Show remote-watch timer status
  nadar --status                    Show the systemd user service status
  nadar --reset                     Reset the local listener baseline
  nadar --help                      Show this help

Remote scan examples:
  nadar --scan
  nadar --scan TCP:420,UDP:11000
  nadar --scan TCP:80,TCP:443,TCP:2222

  Without PORTS, scans all currently monitored non-loopback TCP/UDP
  listener ports. By default, the target is your public IPv4 address
  as reported by ifconfig.co. Nmap runs on the configured SSH host.
  Ouroboros runs /usr/local/libexec/nadar-scan through limited sudo.
  Install remote/nadar-scan and remote/nadar-scan.sudoers first.
  The helper accepts only validated TCP/UDP ports and IPv4 targets.
  TCP "open" confirms reachability from the SSH host, not worldwide.
  UDP "open|filtered" is inconclusive.
  Remote watch is triggered by nadar-remote-watch.timer every 5 minutes.
  Its initial successful scan sets a silent baseline. Subsequent changes
  to the EXACT state "open" trigger desktop alerts; filtered and
  open|filtered never do. Failed scans do not overwrite the baseline.

Configuration: ~/.config/nadar/nadar.conf (or XDG_CONFIG_HOME equivalent)
  LISTENPROTO="TCP,UDP"         TCP, UDP, or both
  EXCLUDEPORTS="UDP:5353"      Ports and optional protocol-specific ranges
  EXCLUDE_PROCESSES="spotify"   Exclude named processes from all output
  EXCLUDE_PIDS=""              Exclude process IDs from all output
  EXCLUDE_PROCESS_NOTIFY=""    Suppress notifications only
  NADAR_INTERVAL=10             Polling interval in seconds
  REMOTE_POKE_HOST="prometheus-alexander.fi"
  REMOTE_POKE_PORT=42000
  REMOTE_SSH_HOST="ouroboros"   SSH alias or remote hostname
  REMOTE_SCAN_TARGET=""        Optional public IPv4 override
  REMOTE_WATCH_PORTS=""        Optional monitored ports (empty = auto-discover)

Security:
  Only scan systems you own or are authorized to test. The port 42000
  responder accepts PING only; Nmap scan commands travel over SSH,
  never through the public TCP responder.
HELP
}

# Output TSV: protocol, state, local_address, port, process, pid.
# Split the local ss endpoint at the last colon into host and port.
# This also supports bracketed IPv6 endpoints such as [::]:port.
collect() {
  local line proto state recvq sendq local_addr peer rest address port proc pid output
  local tail owner_name owner_pid match owners_found pair
  local -a names=() pids=()
  local -A seen_owners=()
  output=$(LC_ALL=C ss -H -tulnp) || return 1
  while IFS= read -r line; do
    read -r proto state recvq sendq local_addr peer rest <<< "$line"
    [[ -n ${local_addr:-} ]] || continue
    address=${local_addr%:*}
    port=${local_addr##*:}
    allowed_listener "$proto" "$port" || continue

    # The ss users field can contain multiple processes/PIDs.
    # Filter owners independently: excluding one PID must not hide
    # another allowed process that shares the same socket.
    tail=${rest:-}
    owners_found=0
    names=(); pids=(); seen_owners=()
    while [[ $tail =~ \(\"([^\"]+)\",pid=([0-9]+) ]]; do
      match=${BASH_REMATCH[0]}
      owner_name=${BASH_REMATCH[1]}
      owner_pid=${BASH_REMATCH[2]}
      tail=${tail#*"$match"}
      ((owners_found+=1))
      is_excluded_owner "$owner_name" "$owner_pid" && continue
      pair="$owner_name"$'\034'"$owner_pid"
      if [[ ! -v seen_owners["$pair"] ]]; then
        seen_owners["$pair"]=1
        names+=("$owner_name")
        pids+=("$owner_pid")
      fi
    done

    if (( owners_found > 0 )); then
      # Every known socket owner was excluded.
      ((${#names[@]} > 0)) || continue
      proc=$(printf '%s, ' "${names[@]}"); proc=${proc%, }
      pid=$(printf '%s, ' "${pids[@]}"); pid=${pid%, }
    else
      # Owner details may be hidden without elevated permissions:
      # we cannot assume the unknown owner matches an exclusion.
      proc='—'; pid='—'
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$proto" "$state" "$address" "$port" "$proc" "$pid"
  done <<< "$output"
}

# Bash printf uses byte-oriented string widths for UTF-8 in this context,
# so a three-byte '—' would shift the following column.
# Add padding based on visible character width; substitute
# '—' -> '-' only while measuring, preserving the displayed dash.
print_padded() {
  local value=$1 width=$2 visible=${1//—/-} pad
  pad=$((width - ${#visible}))
  printf '%s' "$value"
  if ((pad > 0)); then printf '%*s' "$pad" ''; fi
}

show_list() {
  local proto state address port proc pid
  printf '%-5s %-8s %-36s %-8s %-24s %s\n' PROTO STATE ADDRESS PORT PROCESS PID
  printf '%s\n' '────────────────────────────────────────────────────────────────────────────────────────────────'
  while IFS=$'\t' read -r proto state address port proc pid; do
    printf '%b%-5s%b %-8s %b' "$VIOLET" "$proto" "$RESET" "$state" "$BLUE"
    print_padded "$address" 36
    printf '%b %b' "$RESET" "$AMBER"
    print_padded "$port" 8
    printf '%b %b' "$RESET" "$GREEN"
    print_padded "$proc" 24
    printf '%b %b%s%b\n' "$RESET" "$RED" "$pid" "$RESET"
  done < <(collect)
}

# Group sockets with identical protocol/address/port.
# Output: protocol, state, address, port, processes, pids, sockets.
summary_rows() {
  local proto state address port proc pid key item
  local -a names=() numbers=()
  local -A counts=() states=() processes=() pids=() seenproc=() seenpid=()
  local -a order=()
  while IFS=$'\t' read -r proto state address port proc pid; do
    [[ -n $proto && -n $port ]] || continue
    key="${proto}"$'\034'"${address}"$'\034'"${port}"
    if [[ ! -v counts[$key] ]]; then
      counts[$key]=0
      states[$key]=$state
      processes[$key]=''
      pids[$key]=''
      order+=("$key")
    fi
    (( counts[$key]+=1 ))
    if [[ $proc != '—' ]]; then
      IFS=',' read -r -a names <<< "$proc"
      for item in "${names[@]}"; do
        trim "$item"; item=$REPLY
        if [[ -n $item && ! -v seenproc["$key|$item"] ]]; then
          seenproc["$key|$item"]=1
          processes[$key]+="${processes[$key]:+, }$item"
        fi
      done
    fi
    if [[ $pid != '—' ]]; then
      IFS=',' read -r -a numbers <<< "$pid"
      for item in "${numbers[@]}"; do
        trim "$item"; item=$REPLY
        if [[ -n $item && ! -v seenpid["$key|$item"] ]]; then
          seenpid["$key|$item"]=1
          pids[$key]+="${pids[$key]:+, }$item"
        fi
      done
    fi
  done < <(collect)
  for key in "${order[@]}"; do
    IFS=$'\034' read -r proto address port <<< "$key"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$proto" "${states[$key]}" "$address" "$port" \
      "${processes[$key]:-—}" "${pids[$key]:-—}" "${counts[$key]}"
  done
}

show_summary() {
  local proto state address port proc pid sockets
  printf '%b◈ NADAR — PORT SUMMARY%b\n' "$VIOLET" "$RESET"
  printf '%-5s %-8s %-36s %-8s %-22s %-12s %s\n' PROTO STATE ADDRESS PORT PROCESS PID SOCKETS
  printf '%s\n' '──────────────────────────────────────────────────────────────────────────────────────────────────────────────────'
  while IFS=$'\t' read -r proto state address port proc pid sockets; do
    printf '%b%-5s%b %-8s %b' "$VIOLET" "$proto" "$RESET" "$state" "$BLUE"
    print_padded "$address" 36
    printf '%b %b' "$RESET" "$AMBER"
    print_padded "$port" 8
    printf '%b %b' "$RESET" "$GREEN"
    print_padded "$proc" 22
    printf '%b %b' "$RESET" "$RED"
    print_padded "$pid" 12
    printf '%b %s\n' "$RESET" "$sockets"
  done < <(summary_rows)
}

html_escape() {
  local s=$1
  s=${s//&/\&amp;}
  s=${s//</\&lt;}
  s=${s//>/\&gt;}
  s=${s//\"/\&quot;}
  s=${s//\'/\&#39;}
  printf '%s' "$s"
}

summary_html() {
  local report=${NADAR_HTML_PATH:-$PWD/summary.html}
  local temp proto state address port proc pid sockets rows=0 tcp=0 udp=0
  mkdir -p -- "$(dirname -- "$report")"
  temp=$(mktemp "$(dirname -- "$report")/.nadar-summary.XXXXXXXX")
  {
    cat <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
